
{
  "layer": "top",
  "position": "top",
  "height": 34,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 10,
  "margin-right": 10,

  "modules-left": ["hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "network", "bluetooth","custom/notification","custom/power","battery"],

  "hyprland/workspaces": {
    "format": "{name}",
    "on-click": "activate",
    "sort-by-number": true
  },

  "hyprland/window": {
    "format": "{}",
    "max-lenght": 45,
    "seperate-outputs": true
  },

  "clock": {
    "format": "󰥔  {:%a %d %b  %H:%M}",
    "tooltip": false
  },


  "pulseaudio": {
    "format": "󰕾  {volume}%",
    "format-muted": "󰖁  muted",
    "on-click": "pavucontrol",
    "tooltip": false
  },
  
  "bluetooth": {
  "format": " ",
  "format-connected": "  {device_alias}",
  "format-disabled": "󰂲  off",
  "format-off": "󰂲  off",
  "tooltip": true,
  "on-click": "blueman-manager"
},
 "custom/notification": {
    "tooltip": false,
    "format": "󰂚",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d",
    "exec-if": "which swaync-client",
    "return-type": "json",
    "exec": "echo '{\"text\":\"󰂚\",\"class\":\"notification\"}'",
    "interval": 60
},

"custom/power": {
  "format": "⏻",
  "tooltip": false,
  "on-click": "~/.config/rofi/powermenu.sh"
},

  "network": {
    "format-wifi": "󰤨  {essid}",
    "format-ethernet": "󰈀  wired",
    "format-disconnected": "󰤭  offline",
    "tooltip": false
  },

  "battery": {
    "format": "󰁹  {capacity}%",
    "format-charging": "󰂄  {capacity}%",
    "format-warning": "󰁻  {capacity}%",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },

  "tray": {
    "spacing": 8
  }
}

