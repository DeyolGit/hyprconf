
configuration {
    modi: "drun,run,window";
    show-icons: true;

    font: "JetBrainsMono Nerd Font 11";

    drun-display-format: "{name}";
    display-drun: "apps";
    display-run: "run";
    display-window: "windows";

    sidebar-mode: false;
    cycle: true;
    hover-select: false;
    scroll-method: 0;

    matching: "fuzzy";
    case-sensitive: false;

    icon-theme: "Papirus-Dark";

    timeout {
        action: "kb-cancel";
        delay: 0;
    }
}

* {
    bg:        #282828e6;
    bg-alt:    #fabd2f24;
    fg:        #ebdbb2;
    fg-dim:    #a89984;
    line:      #504945;

    border:    0px;
    spacing:   0;
}

window {
    width: 620px;
    location: center;

    background-color: @bg;

    border: 2px;
    border-color: #fabd2fcc;
    border-radius: 16px;

    padding: 24px;
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 18px;
}

inputbar {
    children: [ prompt, entry ];

    spacing: 12px;
    padding: 0;

    background-color: transparent;
}

prompt {
    background-color: transparent;
    text-color: #fabd2f;

    font: "JetBrainsMono Nerd Font 10";
}

entry {
    background-color: transparent;
    text-color: @fg;

    cursor: text;

    placeholder: "search";
    placeholder-color: @fg-dim;

    padding: 0;
}

listview {
    columns: 1;
    lines: 8;

    fixed-height: true;
    dynamic: false;

    scrollbar: false;
    spacing: 2px;

    background-color: transparent;
}

element {
    orientation: horizontal;

    padding: 9px 10px;
    spacing: 12px;

    background-color: transparent;
    text-color: @fg;

    border-radius: 9px;
}

element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element selected.normal {
    background-color: @bg-alt;
    text-color: #fabd2f;

    border-radius: 9px;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;
}

element-icon {
    size: 24px;

    background-color: transparent;

    vertical-align: 0.5;
}

scrollbar {
    width: 0px;
    handle-width: 0px;

    background-color: transparent;
    handle-color: transparent;
}

