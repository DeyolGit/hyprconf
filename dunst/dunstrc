
[global]
    monitor = 0
    follow = none

    width = 360
    height = 140
    origin = top-center
    offset = 0x50
    notification_limit = 6

    progress_bar = true
    progress_bar_height = 4
    progress_bar_min_width = 220
    progress_bar_max_width = 320

    transparency = 0
    separator_height = 2
    padding = 16
    horizontal_padding = 16
    text_icon_padding = 12

    frame_width = 0
    frame_color = "#49E2AF"

    corner_radius = 16
    corners = all

    font = "Inter 10"
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle

    icon_position = left
    min_icon_size = 36
    max_icon_size = 48

    sticky_history = yes
    history_length = 20

    mouse_left_click = close_current
    mouse_middle_click = do_action
    mouse_right_click = close_all

    sort = yes
    stack_duplicates = true
    hide_duplicate_count = false

    timeout = 5

[urgency_low]
    background = "#040e0d"
    foreground = "#7ad9a8"
    frame_color = "#1d3631"
    timeout = 4

[urgency_normal]
    background = "#040e0d"
    foreground = "#f5e2c5"
    frame_color = "#49E2AF"
    timeout = 5

[urgency_critical]
    background = "#040e0d"
    foreground = "#f5e2c5"
    frame_color = "#49E2AF"
    timeout = 0

