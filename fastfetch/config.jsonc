{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "display": {
        "separator": " ",
        "color": {
      "title": "35",
    }, 
    },
    "logo": {
    "type": "auto",
    "source": "NixOS",
    "color": {
      "1": "34",
      "2": "35",
      "3": "34",
      "4": "35",
      "5": "34",
      "6": "35",
  },
  }, 
    "modules": [
	"break",
	{
            "type": "title",
            "keyWidth": 10,
            "keyColor": "35"
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "34",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "35",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "34",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "35", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "35", 
        },
        {
            "type": "display",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ",
            "keyColor": "35"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": " ",
            "keyColor": "35"
        },
        {
             "type": "memory",
            "key": "﬙ ",
            "keyColor": "34"
        },
        {
             "type": "swap",
            "key": "󰾴 ",
            "keyColor": "35"
        },
        {
            "type": "disk",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "35", 
        },
        {
            "type": "command",
            "key": "󱦟 ",
            "keyColor": "34",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        "break",
    ]
}
