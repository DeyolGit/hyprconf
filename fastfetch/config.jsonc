{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    
    "display": {
        "separator": " ",
        "color": {
      "title": "33",
    }, 
    },
    "logo": {
    "type": "auto",
    "source": "/home/mihailo/.config/fastfetch/logo.txt",
    "color": {
      "1": "39"
    },
  
  }, 
    "modules": [
	"break",
	{
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "os",
            "key": " ",
            "keyColor": "33",  // = color4
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "33",
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "33",  
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "display",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "cpu",
            "format": "{1}",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "format": "{2}",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "gpu",
            "format": "{3}",
            "key": " ",
            "keyColor": "33"
        },
        {
             "type": "memory",
            "key": "﬙ ",
            "keyColor": "33"
        },
        {
             "type": "swap",
            "key": "󰾴 ",
            "keyColor": "33"
        },
        {
            "type": "disk",
            "key": " ",
            "keyColor": "33"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "33", 
        },
        {
            "type": "command",
            "key": "󱦟 ",
            "keyColor": "33",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        "break",
    ]
}
